{
  "name": "call-my-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugin"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 30000",
    "check": "bun run typecheck && bun test --timeout 30000"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@cma/protocol": "workspace:*",
    "@cma/relay": "workspace:*",
    "@cma/plugin": "workspace:*"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "license": "MIT"
}
