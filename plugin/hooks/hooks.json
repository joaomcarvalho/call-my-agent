{
  "description": "call-my-agent: bind the session inbox socket and enforce the outbound disclosure policy",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/session-start.js"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_call-my-agent_cma__cma_(say|propose|respond|answer_checkpoint|checkpoint|hangup|start_call)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/disclosure.js"]
          }
        ]
      },
      {
        "matcher": "^(Read|Grep|Glob|NotebookRead)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/read-guard.js"]
          }
        ]
      }
    ]
  }
}
